# Native Megatron generation with GSM8K.
CONFIG_FILE=grpo-chonk-megatron.yaml
ENTRYPOINT=examples/run_grpo.py
GENERATION_BACKEND=megatron
GYM_ENABLED=0
# PRs 6/7 cover native inference state/request capacity and coordinator binding.
NEMO_PRS=(5 1 6 7)
JOB_NAME=gsm8k-chonk-megatron
JOB_TIME=02:00:00
RUN_NAME=nemo-rl-gsm8k-chonk-megatron
TRAIN_NODES=16
INFERENCE_NODES=8
TRAIN_GLOBAL_BATCH=128
DEFAULT_MICRO_BATCH=1
DEFAULT_NUM_PROMPTS=32
GENERATIONS_PER_PROMPT=8
DEFAULT_MAX_NUM_STEPS=2
