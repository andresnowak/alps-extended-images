# Asynchronous vLLM generation with GSM8K; GRPO stays synchronous.
CONFIG_FILE=grpo-chonk-vllm.yaml
ENTRYPOINT=examples/run_grpo.py
GENERATION_BACKEND=vllm
GYM_ENABLED=0
NEMO_PRS=(5 1)
JOB_NAME=gsm8k-chonk
JOB_TIME=05:00:00
RUN_NAME=nemo-rl-gsm8k-chonk
TRAIN_NODES=16
INFERENCE_NODES=8
TRAIN_GLOBAL_BATCH=512
DEFAULT_MICRO_BATCH=2
DEFAULT_NUM_PROMPTS=64
GENERATIONS_PER_PROMPT=16
DEFAULT_MAX_NUM_STEPS=150
